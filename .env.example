# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Authentication & PostgreSQL Database (Optional - application runs seamlessly in local mode if unset)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-Side Supabase Service Role Key (Used strictly for server-side administrative tasks; never expose in client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Firebase Authentication - Google Sign-In (Project: cooknow-9444c)
# Public client configuration for browser-side Google Sign-In.
# Obtain from Firebase Console > Project Settings > General > Your apps > Web app:
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_AUTH_DOMAIN="cooknow-9444c.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="cooknow-9444c"
VITE_FIREBASE_STORAGE_BUCKET="cooknow-9444c.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"

# Indian Payment Gateway Integration Boundary (Razorpay / Cashfree placeholder)
# Verified server-side; do not store card details in browser
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"

