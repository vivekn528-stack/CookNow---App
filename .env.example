# CookNow public Firebase Web App configuration (safe for Vite browser bundle)
# Obtain these values from Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
VITE_FIREBASE_AUTH_DOMAIN=cooknow-9444c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cooknow-9444c
VITE_FIREBASE_STORAGE_BUCKET=cooknow-9444c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_SENDER_ID

# Server-only Firebase Admin SDK credentials (Vercel Environment Variables ONLY).
# NEVER prefix these with VITE_ and NEVER commit real secrets to GitHub.
# Option A (Recommended): Complete Service Account JSON (raw JSON or base64-encoded)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B (Alternative individual fields if Option A is not set):
# FIREBASE_PROJECT_ID=cooknow-9444c
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cooknow-9444c.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

NODE_ENV=production
