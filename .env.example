# CookNow public Firebase Web App configuration (safe for Vite browser bundle)
# Obtain these values from Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
VITE_FIREBASE_AUTH_DOMAIN=cooknow-9444c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cooknow-9444c
VITE_FIREBASE_STORAGE_BUCKET=cooknow-9444c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_SENDER_ID

# Server-only values must NEVER use the VITE_ prefix.
# Configure Firebase Admin credentials in Vercel Environment Variables only
# after implementing the matching secure initialization in server.ts.
# Do not paste service-account JSON into this file or commit credentials.
NODE_ENV=production
