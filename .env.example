# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed in Vite Browser Bundle)
# Note: Client-side variables MUST begin with VITE_. Never put private keys here.
# ------------------------------------------------------------------------------

# Firebase Web App Client Configuration (Project: cooknow-9444c)
# Sourced from Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY="AIzaSyExampleFakeKeyForClientDocsOnly"
VITE_FIREBASE_APP_ID="1:565537301379:web:66efd17ff83d9110ae4cb6"
VITE_FIREBASE_AUTH_DOMAIN="cooknow-9444c.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="cooknow-9444c"
VITE_FIREBASE_STORAGE_BUCKET="cooknow-9444c.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="565537301379"

# Supabase Public Anonymous Configuration (Project: tphoggbtizpzudbhgtjo)
# Sourced from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://tphoggbtizpzudbhgtjo.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_example_anon_key_for_client_docs"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY ENVIRONMENT VARIABLES (Node.js Express / Vercel Serverless)
# CRITICAL SECURITY: Never prefix with VITE_. Never expose to the browser bundle.
# ------------------------------------------------------------------------------

# Supabase Secret Service Role Key (Used for server-authoritative transactions & admin queries)
# Sourced from Supabase Dashboard > Project Settings > API (Secret service_role key)
SUPABASE_SERVICE_ROLE_KEY="eyJh...your-secret-service-role-key-never-share"

# Server Port and Host
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# Gemini AI API Key (Injected automatically in AI Studio environment)
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="https://your-app-domain.com"
